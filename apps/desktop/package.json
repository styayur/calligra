{
  "name": "calligraphy-studio-desktop",
  "version": "0.8.0",
  "private": true,
  "description": "Offline desktop build of Calligraphy Studio",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist:win": "electron-builder --win nsis portable --x64 --publish never"
  },
  "devDependencies": {
    "electron": "45.3.0",
    "electron-builder": "26.18.0",
    "minimatch": "file:../../third_party/legacy-matcher/calligra-legacy-matcher-0.3.0.tgz"
  },
  "overrides": {
    "global-agent": "4.1.3",
    "@electron/asar": {
      "minimatch": "$minimatch"
    },
    "dir-compare": {
      "minimatch": "$minimatch"
    },
    "glob@7": {
      "minimatch": "$minimatch"
    },
    "filelist": {
      "minimatch": "$minimatch"
    },
    "@electron/universal": {
      "minimatch": "11.0.1"
    },
    "app-builder-lib": {
      "minimatch": "11.0.1"
    }
  },
  "build": {
    "appId": "io.github.styayur.calligraphystudio",
    "productName": "Calligraphy Studio",
    "copyright": "Copyright © 2026 Calligraphy Studio contributors",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "companion.cjs",
      "build/icon.png",
      {
        "from": "../web/dist",
        "to": "dist",
        "filter": [
          "**/*"
        ]
      }
    ],
    "extraResources": [
      {
        "from": "../api",
        "to": "companion",
        "filter": ["app/**/*.py", "launch_companion.py", "requirements-companion.txt"]
      },
      {
        "from": "../../third_party/japanese/codh/CC-BY-SA-4.0.txt",
        "to": "companion/CC-BY-SA-4.0.txt"
      }
    ],
    "asar": true,
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "CalligraphyStudio-${version}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Calligraphy Studio",
      "artifactName": "CalligraphyStudio-Setup-${version}-${arch}.${ext}"
    },
    "portable": {
      "artifactName": "CalligraphyStudio-Portable-${version}-${arch}.${ext}"
    }
  },
  "license": "GPL-3.0-or-later"
}
